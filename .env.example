# Server Configuration (Backend)
SERVER_PORT=3000
DATA_DIR=/usr/share/nginx/html/data
BACKUP_DIR=/usr/share/nginx/html/data/backups
BACKUP_LIMIT=30

# Recommended: set the server login password here. If blank, the backend uses
# app.password from dashboard-config.json. Never commit a real .env file.
EDITOR_PASSWORD=

# Frontend Development Variables
# Uncomment for local development only (NOT committed to git)
# VITE_API_URL=http://localhost:3000/
