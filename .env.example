# Copy this file to .env (git-ignored) and fill it in. Never commit a real .env.
#
# All credentials come from the environment. They are never read from, served from
# or written to dashboard-config.json. Required variables are marked REQUIRED:
# the server refuses to start without them.

# Server Configuration (Backend)
SERVER_PORT=3000
# Where the server keeps dashboard-config.json, backups, images and sessions. Used by
# `npm run dev:server`; Docker ignores it and always uses /app/data (mounted from ./data).
DATA_DIR=./data
BACKUP_DIR=./data/backups
BACKUP_LIMIT=30

# REQUIRED: the sign-in password. Plain text or a
# `node docker/hash-password.js '<password>'` hash.
VIEWER_PASSWORD=

# REQUIRED (unless app.localMode is true in dashboard-config.json): the Home
# Assistant connection. HA_URL is an http(s):// URL; HA_ACCESS_TOKEN is a long-lived
# access token (HA profile > Security). Anyone who signs in receives these, because
# the browser connects to Home Assistant directly.
HA_URL=
HA_ACCESS_TOKEN=

# Optional: a second password for editing. When set, signing in with
# VIEWER_PASSWORD is read-only (dashboard and device control, but no editor, config
# save/restore or image upload) and only this password can edit. When blank,
# anyone who signs in can edit. Must differ from VIEWER_PASSWORD.
EDITOR_PASSWORD=

# Optional: how many days a sign-in (and its cookie) lasts, 1-365. Default 30.
# Sessions survive server restarts, but changing a password signs everyone out.
SESSION_DAYS=30

# Frontend Development Variables
# Uncomment for local development only (NOT committed to git)
# VITE_API_URL=http://localhost:3000/
