{
  "name": "ha-dashboard",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node docker/app-server.js",
    "dev:full": "npm run build && concurrently \"npm run dev\" \"npm run dev:server\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start:prod": "node docker/app-server.js"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@mdi/js": "^7.4.47",
    "bootstrap": "^5.3.8",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "home-assistant-js-websocket": "^9.7.1",
    "json-parse-even-better-errors": "^6.0.0",
    "multer": "^2.4.0",
    "pinia": "^4.0.3",
    "sharp": "^0.35.5",
    "vue": "^3.5.43",
    "vue-draggable-next": "^2.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/multer": "^2.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.1.1",
    "@vue/test-utils": "^2.5.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.12",
    "ws": "^8.22.0"
  },
  "overrides": {
    "@humanfs/node": "^0.16.8",
    "serialize-javascript": "^7.0.3",
    "shell-quote": "^1.11.0"
  }
}
